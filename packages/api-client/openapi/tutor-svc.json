    "/api/ef/breakdown": {
      "post": {
        "tags": [
          "Executive Function"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "learnerId",
                  "taskId",
                  "title"
                ],
                "properties": {
                  "learnerId": {
                    "type": "string"
                  },
                  "taskId": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "modalities": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "string",
                      "enum": [
                        "visual",
                        "auditory",
                        "kinesthetic",
                        "reading"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
